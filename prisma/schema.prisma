generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  name                 String
  email                String           @unique
  passwordHash         String
  status               String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  role                 String           @default("USER")   // SUPER_ADMIN, USER
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lastLoginAt          DateTime?

  memberships          SocietyMember[]
  createdTransactions  Transaction[]    @relation("CreatedTransactions")
  approvedTransactions Transaction[]    @relation("ApprovedTransactions")
  voidedTransactions   Transaction[]    @relation("VoidedTransactions")
  createdBudgets       Budget[]         @relation("CreatedBudgets")
  uploadedDocuments    Document[]       @relation("UploadedDocuments")
  auditLogs            AuditLog[]       @relation("UserAuditLogs")
  notifications        Notification[]
  generatedReports     Report[]         @relation("GeneratedReports")
}

model Society {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique // Short code / slug e.g. "tech-soc"
  description          String?
  logo                 String?
  contactEmail         String
  contactPhone         String?
  status               String                @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  members              SocietyMember[]
  financialYears       FinancialYear[]
  categories           Category[]
  events               Event[]
  budgets              Budget[]
  transactions         Transaction[]
  documents            Document[]
  auditLogs            AuditLog[]
  reports              Report[]
  transparencySettings TransparencySettings?
  notifications        Notification[]
}

model SocietyMember {
  id        String   @id @default(cuid())
  societyId String
  userId    String
  role      String   // MEMBER, TREASURER, FACULTY_COORDINATOR, SOCIETY_ADMIN
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([societyId, userId])
  @@index([societyId])
  @@index([userId])
}

model FinancialYear {
  id             String        @id @default(cuid())
  societyId      String
  name           String        // e.g. "2026-27"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean       @default(false)
  openingBalance BigInt        @default(0) // Stored in minor currency units (paise)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  society        Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  events         Event[]
  reports        Report[]

  @@unique([societyId, name])
  @@index([societyId])
}

model Category {
  id          String        @id @default(cuid())
  societyId   String?       // null = Global category, otherwise society-specific
  name        String
  type        String        // INCOME, EXPENSE, BOTH
  description String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  society     Society?      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets     Budget[]

  @@index([societyId])
  @@index([type])
}

model Event {
  id              String        @id @default(cuid())
  societyId       String
  financialYearId String
  name            String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  organizer       String?
  allocatedBudget BigInt        @default(0) // In paise
  status          String        @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, CANCELLED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  society         Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgets         Budget[]

  @@index([societyId])
  @@index([financialYearId])
  @@index([status])
}

model Budget {
  id              String        @id @default(cuid())
  societyId       String
  financialYearId String
  eventId         String?
  categoryId      String?
  allocatedAmount BigInt        // In paise
  createdById     String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  society         Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User          @relation("CreatedBudgets", fields: [createdById], references: [id])

  @@index([societyId])
  @@index([financialYearId])
  @@index([eventId])
  @@index([categoryId])
}

model Transaction {
  id                String        @id @default(cuid())
  transactionNumber String        @unique // e.g. "TXN-2026-0001"
  societyId         String
  financialYearId   String
  type              String        // INCOME, EXPENSE
  status            String        @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, VOIDED
  amount            BigInt        // In paise, always > 0
  categoryId        String
  eventId           String?
  description       String
  transactionDate   DateTime
  paymentMethod     String        // BANK_TRANSFER, UPI, CASH, CARD, CHEQUE, OTHER
  referenceNumber   String?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  voidReason        String?
  voidedById        String?
  voidedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  society           Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  financialYear     FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  category          Category      @relation(fields: [categoryId], references: [id])
  event             Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy         User          @relation("CreatedTransactions", fields: [createdById], references: [id])
  approvedBy        User?         @relation("ApprovedTransactions", fields: [approvedById], references: [id], onDelete: SetNull)
  voidedBy          User?         @relation("VoidedTransactions", fields: [voidedById], references: [id], onDelete: SetNull)
  documents         Document[]

  @@index([societyId])
  @@index([financialYearId])
  @@index([transactionDate])
  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@index([eventId])
  @@index([createdById])
  @@index([approvedById])
}

model Document {
  id            String       @id @default(cuid())
  transactionId String?
  societyId     String
  fileName      String
  storageKey    String
  mimeType      String
  size          Int
  uploadedById  String
  uploadedAt    DateTime     @default(now())

  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  society       Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  uploadedBy    User         @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([transactionId])
  @@index([societyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  societyId  String?
  userId     String?
  action     String   // LOGIN, LOGOUT, TRANSACTION_CREATE, TRANSACTION_SUBMIT, TRANSACTION_APPROVE, TRANSACTION_REJECT, TRANSACTION_VOID, etc.
  entityType String   // TRANSACTION, BUDGET, EVENT, USER, SOCIETY, REPORT, AUTH, SETTING
  entityId   String?
  oldData    String?  // JSON string
  newData    String?  // JSON string
  metadata   String?  // JSON string
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  society    Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([societyId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  societyId String?
  type      String   // APPROVAL_REQUEST, APPROVAL_GRANTED, APPROVAL_REJECTED, BUDGET_WARNING, SYSTEM
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society   Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Report {
  id              String        @id @default(cuid())
  reportNumber    String        @unique // e.g. "REP-2026-0001"
  societyId       String
  financialYearId String
  title           String
  reportType      String        // MONTHLY, ANNUAL, INCOME, EXPENSE, CATEGORY, EVENT, BUDGET
  periodStart     DateTime?
  periodEnd       DateTime?
  generatedById   String
  generatedAt     DateTime      @default(now())
  publishedAt     DateTime?
  status          String        @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  summaryJson     String        // JSON payload containing calculated financial summary
  isPublic        Boolean       @default(false)

  society         Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  generatedBy     User          @relation("GeneratedReports", fields: [generatedById], references: [id])

  @@index([societyId])
  @@index([financialYearId])
  @@index([status])
  @@index([isPublic])
}

model TransparencySettings {
  id                       String   @id @default(cuid())
  societyId                String   @unique
  showTotalIncome          Boolean  @default(true)
  showTotalExpenses        Boolean  @default(true)
  showCategoryBreakdown    Boolean  @default(true)
  showEventBudgets         Boolean  @default(true)
  showTransactionLevelData Boolean  @default(false)
  showReports              Boolean  @default(true)
  showMonthlyTrends        Boolean  @default(true)
  customDisclaimer         String?
  updatedAt                DateTime @default(now()) @updatedAt

  society                  Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
}
